{
  "entities": {
    "User": {
      "title": "User",
      "description": "NFC-IET student, teacher, or administrative user profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "description": "Firebase Auth UID" },
        "name": { "type": "string", "maxLength": 100, "description": "Full name of the user" },
        "email": { "type": "string", "format": "email", "maxLength": 150, "description": "Institutional or personal email" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"], "description": "Institutional role" },
        "rollNumber": { "type": "string", "maxLength": 30, "description": "Student roll number or employee ID" },
        "section": { "type": "string", "maxLength": 20, "description": "Class section" },
        "department": { "type": "string", "maxLength": 80, "description": "Department name" },
        "createdAt": { "type": "string", "description": "Account registration timestamp" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "AttendanceSession": {
      "title": "AttendanceSession",
      "description": "Active or historical lecture attendance QR session generated by an instructor.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Session unique identifier" },
        "teacherId": { "type": "string", "maxLength": 128, "description": "Instructor UID" },
        "teacherName": { "type": "string", "maxLength": 100, "description": "Instructor full name" },
        "subjectId": { "type": "string", "maxLength": 50, "description": "Course code or subject ID" },
        "subjectName": { "type": "string", "maxLength": 100, "description": "Name of the academic subject" },
        "section": { "type": "string", "maxLength": 20, "description": "Class section" },
        "lectureDate": { "type": "string", "maxLength": 30, "description": "Lecture date string" },
        "slotTime": { "type": "string", "maxLength": 50, "description": "Lecture timetable slot" },
        "code": { "type": "string", "maxLength": 64, "description": "QR token code for security validation" },
        "status": { "type": "string", "enum": ["active", "closed"], "description": "Live status of QR scanner session" },
        "createdAt": { "type": "string", "description": "Session creation server timestamp" }
      },
      "required": ["id", "teacherId", "teacherName", "subjectName", "section", "status", "code"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Student attendance verification record for a lecture.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Attendance record unique ID" },
        "sessionId": { "type": "string", "maxLength": 128, "description": "Linked attendance session ID" },
        "studentId": { "type": "string", "maxLength": 128, "description": "Student user UID" },
        "studentRoll": { "type": "string", "maxLength": 30, "description": "Student roll number" },
        "studentName": { "type": "string", "maxLength": 100, "description": "Student full name" },
        "subjectName": { "type": "string", "maxLength": 100, "description": "Academic course subject" },
        "status": { "type": "string", "enum": ["present", "absent", "late"], "description": "Attendance status" },
        "markedVia": { "type": "string", "enum": ["qr_scanner", "manual_teacher", "admin_override"], "description": "Method of attendance entry" },
        "timestamp": { "type": "string", "description": "Server timestamp of marked attendance" }
      },
      "required": ["id", "sessionId", "studentId", "studentRoll", "studentName", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Institutional administration audit trace.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Audit event ID" },
        "userId": { "type": "string", "maxLength": 128, "description": "User UID initiating action" },
        "userName": { "type": "string", "maxLength": 100, "description": "User display name" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"], "description": "User role" },
        "action": { "type": "string", "maxLength": 80, "description": "Action performed" },
        "details": { "type": "string", "maxLength": 500, "description": "Detailed log description" },
        "timestamp": { "type": "string", "description": "Event timestamp" }
      },
      "required": ["id", "userId", "userName", "action", "details"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection containing institutional profile data."
    },
    "/admins/{adminId}": {
      "schema": "User",
      "description": "Privileged administrator marker documents for role-based access control."
    },
    "/sessions/{sessionId}": {
      "schema": "AttendanceSession",
      "description": "Lecture attendance sessions managed by teachers."
    },
    "/sessions/{sessionId}/records/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Sub-collection of student attendance records for a specific lecture session."
    },
    "/attendance_records/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Global student attendance records collection for student dashboard history."
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit trails for institutional administrative operations."
    }
  }
}
